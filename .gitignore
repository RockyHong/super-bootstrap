# claude-config-manager — served-artifact markers (content committed; only local markers ignored)
.claude/skills/*/.served
.claude/agents/*.md.served
.claude/rules/*.md.served

# claude-config-manager — consult-check hook per-session cache (regenerated, local-only)
.claude/.consult-catalog

# drain — worktree isolation (frozen infra)
.claude/worktrees/
.drain-status

# local settings — never repo state. Committed settings.json is the only durable
# source, so device behavior stays identical everywhere; anything here is a
# one-off carve-out, discarded when the work that needed it finishes.
.claude/settings.local.json
